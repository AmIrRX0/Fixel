# GitHub personal access token (classic with `repo` scope, or fine-grained with
# Contents: Read/Write + Issues: Read + Pull requests: Read/Write on the target repo).
# In fork mode the token only needs push access to YOUR fork.
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Anthropic API key used by the Claude Agent SDK.
# Optional if the `claude` CLI on this machine is already logged in.
# Only needed when using the default Claude provider. A locally authenticated
# Codex CLI can instead be selected with: --provider codex
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# Optional overrides
# FIXEL_PROVIDER=codex
# AGENT_MODEL=claude-opus-5
# AGENT_WORKDIR=/tmp/fixel
